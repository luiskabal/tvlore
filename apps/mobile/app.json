{
  "expo": {
    "name": "TVLore",
    "slug": "tvlore",
    "scheme": "tvlore",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-apple-authentication",
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#080b12"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.luiskabal.tvlore",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.luiskabal.tvlore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#080b12"
      },
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "73bfb1b3-bcb2-41a8-8352-0b984c0bbad9"
      }
    },
    "owner": "luiskabal"
  }
}
