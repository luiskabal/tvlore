    "@prisma/client": "^7.9.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "~5.9.2"
  }
}
