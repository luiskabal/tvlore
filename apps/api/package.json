    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "start": "node dist/src/main.js",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
