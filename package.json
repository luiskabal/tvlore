{
  "name": "tvlore",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "TVLore mobile-first entertainment tracking monorepo.",
  "scripts": {
    "api:check": "node tools/check-api.mjs",
    "env:check": "node tools/check-env.mjs",
    "eas:env:check": "node tools/check-eas-envs.mjs",
    "auth:redirect:check": "node tools/check-supabase-auth-redirect.mjs",
    "store:check": "node tools/check-store-public-pages.mjs",
    "release:preflight": "node tools/check-mobile-release.mjs",
    "release:android:preflight": "node tools/check-mobile-release.mjs --target=android",
    "release:android:smoke": "corepack pnpm eas:env:check && corepack pnpm release:android:preflight && corepack pnpm store:check && corepack pnpm auth:redirect:check && corepack pnpm verify:full && corepack pnpm api:check",
    "release:android:build:preview": "node tools/run-eas-mobile.mjs build --profile preview --platform android",
    "release:android:build:production": "node tools/run-eas-mobile.mjs build --profile production --platform android",
    "release:android:submit:production": "node tools/run-eas-mobile.mjs submit --profile production --platform android --latest --wait --non-interactive",
    "release:android:build-and-submit:production": "node tools/run-eas-mobile.mjs build --profile production --platform android --auto-submit --wait --non-interactive",
    "db:migrate": "corepack pnpm --filter @tvlore/api db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @tvlore/api db:migrate:deploy",
    "db:logs": "docker compose logs -f postgres",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "test:run": "corepack pnpm -r --if-present test:run",
    "typecheck": "corepack pnpm -r typecheck",
    "verify": "corepack pnpm typecheck && corepack pnpm test:run",
    "verify:full": "corepack pnpm verify && corepack pnpm build",
    "release:smoke:public": "corepack pnpm release:preflight && corepack pnpm store:check && corepack pnpm auth:redirect:check && corepack pnpm verify:full && corepack pnpm api:check",
    "release:smoke": "corepack pnpm env:check && corepack pnpm eas:env:check && corepack pnpm release:smoke:public",
    "build": "corepack pnpm -r --if-present build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
